# Default: deterministic rule-based simulation; no key or download required.
ACE_MODE=simulation
ACE_DB=data/ace.sqlite3
# Optional local model. Install and pull this model separately before enabling.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional bearer token for an authenticated model gateway; never committed.
MODEL_API_KEY=
